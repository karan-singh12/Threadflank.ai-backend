# ─── New env vars only — see .env for the full existing configuration ───────
# These power the GenAI SDK (backend/src/sdk) and the new admin panel
# (backend/src/modules/admin-auth, brands, brand-posts, brand-stories,
# email-templates, cms, admin-users).

# ─── GenAI SDK: LLM providers ────────────────────────────────────────────────
# Set any subset. Providers without a key are skipped by the router, so every
# task still runs as long as at least one key is present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com
OPENAI_API_KEY=

# Default provider when a task type has no explicit routing rule (gemini | claude | openrouter | groq | openai)
DEFAULT_LLM_PROVIDER=gemini

# Model per provider (see sdk/core/router/router-config.ts)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLAUDE_MODEL=claude-opus-5
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4.1-mini
# A free-tier OpenRouter key only serves ":free" models
OPENROUTER_BULK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Provider per task; the model follows the provider
CAPTION_TASK_PROVIDER=gemini
AGENT_TASK_PROVIDER=claude
COMBOS_TASK_PROVIDER=gemini
BULK_TASK_PROVIDER=groq
RAG_TASK_PROVIDER=gemini
# Order tried when the routed provider fails or has no key
LLM_FALLBACK_CHAIN=gemini,groq,claude,openrouter,openai

# ─── GenAI SDK: RAG vector store (Pinecone) ──────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=threadflank-rag

# ─── End-user auth ───────────────────────────────────────────────────────────
# Required outside local dev: when unset, user tokens are signed with a hard-coded default.
JWT_SECRET=

# ─── Admin/staff auth (separate from end-user auth) ──────────────────────────
# Also required: unset admin secrets fall back to hard-coded defaults.
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_PASSWORD_RESET_EXPIRES_MIN=30
# admin-panel/ dev server runs on :3001
ADMIN_PASSWORD_RESET_URL=http://localhost:3001/reset-password/

# ─── End-user password reset (new) ───────────────────────────────────────────
# frontend/ dev server runs on :3000
USER_PASSWORD_RESET_URL=http://localhost:3000/reset-password/

# One-time super-admin seed (npm run seed) — change the password immediately after
ADMIN_SEED_EMAIL=superadmin@threadflank.com
ADMIN_SEED_PASSWORD=

# ─── Email (nodemailer) ───────────────────────────────────────────────────────
MAIL_FROM="Threadflank <no-reply@threadflank.com>"

# ─── Drape Studio / Image Generation Engines ─────────────────────────────────
# Supported: gemini, replicate
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Model for creating twins (made once, then reused by Drape). Defaults to the cheaper Lite model.
GEMINI_TWIN_MODEL=gemini-3.1-flash-lite-image
# Optional model for multi-person Drape group photos (rendered in one request). A Pro-tier
# image model keeps several faces consistent better; falls back to GEMINI_IMAGE_MODEL.
GEMINI_GROUP_MODEL=gemini-3.1-flash-image
# Most reference images in one group request (every twin + photographed pieces + scene); bigger groups dress people separately, then compose.
GEMINI_GROUP_MAX_IMAGES=14
REPLICATE_API_TOKEN=
# Engine order preference (comma-separated): gemini,replicate or replicate,gemini
IMAGE_ENGINES=gemini,replicate

# ─── Cloudflare R2 Storage (Recommended for zero egress fees) ───────────────
# When R2_ACCOUNT_ID and R2_ACCESS_KEY_ID are set, R2 is used as the primary storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=outfit-checker
# Public bucket URL or custom domain (e.g. https://assets.yourdomain.com or https://pub-xxxx.r2.dev)
R2_PUBLIC_DOMAIN=

# ─── Supabase Storage (Alternative cloud storage) ─────────────────────────────
# When SUPABASE_URL is set and R2 is unset, images upload to Supabase buckets.
# When neither is set, system falls back safely to LocalStorageProvider (public/).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_DRAPE=drape-results
SUPABASE_STORAGE_BUCKET_TWINS=twin-images
SUPABASE_STORAGE_BUCKET_MODELS=model-images
SUPABASE_STORAGE_BUCKET_GARMENTS=garment-images



# Razorpay (credit packs). Payments stay off until the key id and secret are set.
# Webhook URL to add in the Razorpay dashboard: https://<your-api-host>/api/billing/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
