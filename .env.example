# ─── New env vars only — see .env for the full existing configuration ───────
# These power the GenAI SDK (backend/src/sdk) and the new admin panel
# (backend/src/modules/admin-auth, brands, brand-posts, brand-stories,
# email-templates, cms, admin-users).

# ─── GenAI SDK: LLM providers ────────────────────────────────────────────────
# Set any subset. Providers without a key are skipped by the router, so every
# task still runs as long as at least one key is present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com
OPENAI_API_KEY=

# Default provider when a task type has no explicit routing rule (gemini | claude | openrouter | groq | openai)
DEFAULT_LLM_PROVIDER=gemini

# Model per provider (see sdk/core/router/router-config.ts)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLAUDE_MODEL=claude-opus-5
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4.1-mini
# A free-tier OpenRouter key only serves ":free" models
OPENROUTER_BULK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Provider per task; the model follows the provider
CAPTION_TASK_PROVIDER=gemini
AGENT_TASK_PROVIDER=claude
COMBOS_TASK_PROVIDER=gemini
BULK_TASK_PROVIDER=groq
RAG_TASK_PROVIDER=gemini
# Order tried when the routed provider fails or has no key
LLM_FALLBACK_CHAIN=gemini,groq,claude,openrouter,openai

# ─── GenAI SDK: RAG vector store (Pinecone) ──────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=threadflank-rag

# ─── End-user auth ───────────────────────────────────────────────────────────
# Required outside local dev: when unset, user tokens are signed with a hard-coded default.
JWT_SECRET=

# ─── Admin/staff auth (separate from end-user auth) ──────────────────────────
# Also required: unset admin secrets fall back to hard-coded defaults.
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_PASSWORD_RESET_EXPIRES_MIN=30
# admin-panel/ dev server runs on :3001
ADMIN_PASSWORD_RESET_URL=http://localhost:3001/reset-password/

# ─── End-user password reset (new) ───────────────────────────────────────────
# frontend/ dev server runs on :3000
USER_PASSWORD_RESET_URL=http://localhost:3000/reset-password/

# One-time super-admin seed (npm run seed) — change the password immediately after
ADMIN_SEED_EMAIL=superadmin@threadflank.com
ADMIN_SEED_PASSWORD=

# ─── Email (nodemailer) ───────────────────────────────────────────────────────
# SERVICE/EMAIL/PASS/HOST/EMAIL_PORT already exist as empty placeholders in .env — fill those in.
MAIL_FROM="Threadflank <no-reply@threadflank.com>"
