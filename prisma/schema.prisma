generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  dropWaitlist        DropWaitlistEntry[]
  brandFollows        BrandFollow[]
  brandReviews        BrandProductReview[]
  brandThreads        BrandThread[]
  brandPollVotes      BrandPollVote[]
  brandUgc            BrandUgc[]
  creatorCollabs      CreatorCollab[]
  email               String              @unique
  username            String?             @unique
  password            String
  role                Role                @default(USER)
  accountType         AccountType         @default(NORMAL)
  bio                 String?
  phone               String?
  location            String?
  avatar              String?
  sentFriendships     Friendship[]        @relation("SentFriendships")
  receivedFriendships Friendship[]        @relation("ReceivedFriendships")
  conversationsAsA    Conversation[]      @relation("ConvUserA")
  conversationsAsB    Conversation[]      @relation("ConvUserB")
  sentMessages        Message[]           @relation("MessageSender")
  createdGroups       GroupConversation[] @relation("GroupCreator")
  groupMemberships    GroupMember[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Presence tracking
  isOnline Boolean  @default(false)
  lastSeen DateTime @default(now())
  socketId String?

  // Relations for new models
  reactions         MessageReaction[]
  messageReads      MessageRead[]
  messageDeliveries MessageDelivery[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  sentCallLogs      CallLog[]         @relation("CallLogsAsCaller")
  receivedCallLogs  CallLog[]         @relation("CallLogsAsReceiver")
  wardrobeItems     WardrobeItem[]
  looks             Look[]
  twinProfile       TwinProfile?

  // Image credits: each generated image spends credits; new accounts get the free amount once.
  // Existing accounts default to verified; signup creates new ones as false until the email link is used.
  emailVerified        Boolean   @default(true)
  creditBalance        Int       @default(0)
  freeCreditsGrantedAt DateTime?
}

// ─── 1:1 Conversations ────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  lastMessageId String?

  userA    User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  // Settings
  isArchivedA Boolean @default(false)
  isArchivedB Boolean @default(false)
  isMutedA    Boolean @default(false)
  isMutedB    Boolean @default(false)
  isPinnedA   Boolean @default(false)
  isPinnedB   Boolean @default(false)
  isDeletedA  Boolean @default(false)
  isDeletedB  Boolean @default(false)

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
}

// ─── Group Conversations ──────────────────────────────────────────────────────

model GroupConversation {
  id            String    @id @default(cuid())
  name          String
  avatar        String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  description   String?
  isArchived    Boolean   @default(false)
  isDeleted     Boolean   @default(false)

  creator  User          @relation("GroupCreator", fields: [createdBy], references: [id])
  members  GroupMember[]
  messages Message[]

  @@index([lastMessageAt])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  joinedAt   DateTime  @default(now())
  role       GroupRole @default(MEMBER)
  mutedUntil DateTime?

  group GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// ─── Unified Message (1:1 or Group) ──────────────────────────────────────────

model Message {
  id             String   @id @default(cuid())
  senderId       String
  content        String
  sentAt         DateTime @default(now())
  conversationId String?
  groupId        String?

  edited           Boolean   @default(false)
  editedAt         DateTime?
  deletedAt        DateTime?
  replyToMessageId String?
  attachmentUrl    String?
  attachmentType   String?
  metadata         Json?

  sender       User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  group        GroupConversation? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  reactions  MessageReaction[]
  reads      MessageRead[]
  deliveries MessageDelivery[]

  @@index([conversationId, sentAt])
  @@index([groupId, sentAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([readAt])
}

model MessageDelivery {
  id          String   @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model TrafficLog {
  id               Int      @id @default(autoincrement())
  ip               String   @db.VarChar(45)
  method           String   @db.VarChar(10)
  url              String
  statusCode       Int      @map("status_code")
  responseTime     Int      @map("response_time")
  userAgent        String?  @map("user_agent")
  userId           String?  @map("user_id") @db.VarChar(255)
  userType         String?  @map("user_type") @db.VarChar(20)
  timestamp        DateTime
  requestBody      Json?    @map("request_body")
  errorMessage     String?  @map("error_message")
  suspicious       Boolean  @default(false)
  suspicionReasons Json?    @map("suspicion_reasons")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("traffic_logs")
}

/// IPs banned by the security module (auto or manual). Reloaded into memory on boot so
/// bans survive deploys; rows are kept after expiry as an audit trail.
model BlockedIp {
  id              Int      @id @default(autoincrement())
  ip              String   @unique @db.VarChar(45)
  reason          String
  category        String   @db.VarChar(40)
  offenses        Int      @default(1)
  blockedRequests Int      @default(0) @map("blocked_requests")
  bannedAt        DateTime @map("banned_at")
  expiresAt       DateTime @map("expires_at")
  /// false once an admin lifts the ban
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active, expiresAt])
  @@map("blocked_ips")
}

/// One row per UTC day of security counters, powering "N bots blocked" metrics.
model SecurityDailyStat {
  date            DateTime @id @db.Date
  threats         Int      @default(0)
  blockedRequests Int      @default(0) @map("blocked_requests")
  bansIssued      Int      @default(0) @map("bans_issued")
  categories      Json?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("security_daily_stats")
}

enum Role {
  USER
  ADMIN
}

/// NORMAL = free account; PURCHASED = has bought (or been given) paid access. Editable from the admin panel.
enum AccountType {
  NORMAL
  PURCHASED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ─── Social Feed Models ──────────────────────────────────────────────────────

model Post {
  id        String        @id @default(cuid())
  content   String
  imageUrl  String?
  createdAt DateTime      @default(now())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CallLog {
  id         String   @id @default(cuid())
  callerId   String
  receiverId String
  status     String // "completed", "missed", "rejected"
  video      Boolean  @default(false)
  duration   Int      @default(0) // duration in seconds
  createdAt  DateTime @default(now())

  caller   User @relation("CallLogsAsCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallLogsAsReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([createdAt])
}

model WardrobeItem {
  id         String    @id @default(cuid())
  userId     String
  name       String
  brand      String?
  category   String
  image      String
  color      String?
  tags       Json? // Stored as an array of strings e.g. ["Casual", "Work"]
  wornCount  Int       @default(0)
  lastWornAt DateTime?
  costPaid   Int? // Whole rupees, user-entered
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearLogs       WardrobeItemWearLog[]
  borrowRequests BorrowRequest[]

  @@index([userId])
  @@index([category])
}

/// One row per "I wore this" so cost-per-wear can be charted over time.
model WardrobeItemWearLog {
  id             String   @id @default(cuid())
  wardrobeItemId String
  userId         String
  wornAt         DateTime @default(now())
  lookId         String?
  eventId        String?

  wardrobeItem WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@index([wardrobeItemId, wornAt])
  @@index([userId, wornAt])
}

model Look {
  id                     String    @id @default(cuid())
  userId                 String
  name                   String
  occasion               String // "casual", "formal", "party", "work", "date"
  image                  String // The try-on image or piece photo
  gradient               String? // Styling gradient background
  pieces                 Json // Array of category names / piece tags
  liked                  Boolean   @default(false)
  poseVariants           Json? // [{ pose: "side", imageUrl }]
  videoUrl               String? // Liveness clip (MP4)
  stylistReviewRequested Boolean   @default(false)
  reviewRequestedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stylistComments LookStylistComment[]
  shares          ShareEvent[]
  eventPlans      EventOutfitPlan[]

  @@index([userId])
  @@index([stylistReviewRequested, reviewRequestedAt])
}

// ══════════════════════════════════════════════════════════════════════════
// Admin Panel — separate staff/admin domain (does NOT touch the User model
// or the end-user auth flow above). AdminUser is a wholly distinct identity
// from User; scalar `userId` / `adminUserId` fields below that point at
// User intentionally have no Prisma relation back onto `model User`.
// ══════════════════════════════════════════════════════════════════════════

// ─── Admin / Staff Auth ───────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  BRAND_MANAGER
}

model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens    AdminRefreshToken[]
  passwordResets   AdminPasswordReset[]
  auditLogs        AdminAuditLog[]
  brandAssignments BrandManagerAssignment[]

  @@index([role])
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminPasswordReset {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Partner Brands (Discover / Trending feed) ───────────────────────────────

enum BrandStatus {
  ACTIVE
  INACTIVE
  PENDING // self-registered brand waiting for admin approval; hidden from shoppers
}

model Brand {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  logoUrl          String?
  description      String?
  websiteUrl       String?
  category         String?
  isVerified       Boolean     @default(false)
  status           BrandStatus @default(ACTIVE)
  socialLinks      Json?
  isDeleted        Boolean     @default(false)
  createdByAdminId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Embeddable D2C try-on widget
  widgetKey     String? @unique
  widgetEnabled Boolean @default(false)
  widgetDomains Json? // Allowed storefront origins, e.g. ["https://shop.example.com"]

  /// GST number as the brand entered it (format-checked, not verified with the GST portal).
  gstin String?
  /// Set when staff have checked the GSTIN against the GST portal; cleared whenever the number changes.
  gstVerifiedAt DateTime?
  gstVerifiedBy String?
  /// Which emails the brand team gets (see notify/brand-notify.ts). Missing keys mean on.
  notifyPrefs Json?
  /// Monthly plan (FREE, GROWTH or PRO). A paid plan counts only while planUntil is in the future.
  plan      String    @default("FREE")
  planUntil DateTime?

  /// Store Builder: the layout being edited and not yet published (see store-layout.ts). Null = nothing unpublished.
  storeDraft       Json?
  /// The layout shoppers see. Null = the default store page.
  storeLayout      Json?
  storePublishedAt DateTime?
  /// Earlier store URLs (slugs) that still lead here after a rename. Newest first, at most 5.
  previousSlugs    String[]  @default([])

  managers       BrandManagerAssignment[]
  accounts       BrandAccount[]
  posts          BrandPost[]
  stories        BrandStory[]
  widgetSessions BrandWidgetSession[]
  events         BrandEvent[]
  followers      BrandFollow[]
  savedContent   BrandContentItem[]
  videos         BrandVideo[]
  reels          BrandReel[]
  modelShots     BrandModelShot[]
  payments       BrandPayment[]
  products       BrandProduct[]
  drops          BrandDrop[]
  bids           Bid[]
  rankings       BrandRanking[]
  campaignEntries CampaignEntry[]
  updates         BrandUpdate[]
  threads         BrandThread[]
  savedReplies    BrandSavedReply[]
  reviews         BrandProductReview[]
  ugc             BrandUgc[]
  offers          BrandOffer[]
  collabs         CreatorCollab[]

  @@index([status])
  @@index([isDeleted])
  // The brands directory: live brands in name order.
  @@index([status, isDeleted, name])
  @@index([previousSlugs], type: Gin)
}

model BrandManagerAssignment {
  id          String   @id @default(cuid())
  adminUserId String
  brandId     String
  assignedAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, brandId])
}

// ─── Brand panel accounts ────────────────────────────────────────────────────
// A brand's own login (separate from User and AdminUser). One Brand can have several accounts.

enum BrandAccountRole {
  OWNER // everything, including billing and the team
  MANAGER // everything except billing and the team
  VIEWER // read-only, without deep insights or billing
  CONTENT // edits the catalog, AI Studio, launches, store page and community; nothing else
  ANALYST // read-only, with deep insights, payments and invoices
}

model BrandAccount {
  id            String           @id @default(cuid())
  brandId       String
  email         String           @unique
  password      String
  name          String
  role          BrandAccountRole @default(OWNER)
  isActive      Boolean          @default(true)
  emailVerified Boolean          @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  refreshTokens BrandRefreshToken[]
  authTokens    BrandAuthToken[]

  @@index([brandId])
}

model BrandRefreshToken {
  id             String    @id @default(cuid())
  brandAccountId String
  tokenHash      String
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  brandAccount BrandAccount @relation(fields: [brandAccountId], references: [id], onDelete: Cascade)

  @@index([brandAccountId])
  @@index([tokenHash])
}

// ─── Brand Editorial Posts ────────────────────────────────────────────────────

enum BrandAuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// One-time emailed links (verify email, reset password). Only the hash of the token is stored.
model BrandAuthToken {
  id             String                @id @default(cuid())
  brandAccountId String
  purpose        BrandAuthTokenPurpose
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime              @default(now())

  brandAccount BrandAccount @relation(fields: [brandAccountId], references: [id], onDelete: Cascade)

  @@index([brandAccountId, purpose])
  @@index([tokenHash])
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model BrandPost {
  id               String        @id @default(cuid())
  brandId          String
  title            String?
  caption          String
  images           Json
  category         String?
  taggedProducts   Json?
  status           ContentStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  failureReason    String?
  isDeleted        Boolean       @default(false)
  /// Times someone shared the post from the app (card, WhatsApp or link).
  sharesCount      Int           @default(0)
  createdByAdminId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand    Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  likes    BrandPostLike[]
  comments BrandPostComment[]
  variants BrandProductVariant[]

  @@index([brandId, status])
  @@index([status, scheduledAt])
}

model BrandPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BrandPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model BrandPostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post BrandPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ─── Brand Stories (24h TTL carousel) ─────────────────────────────────────────

model BrandStory {
  id               String   @id @default(cuid())
  brandId          String
  mediaUrl         String
  mediaType        String // "IMAGE" | "VIDEO"
  caption          String?
  expiresAt        DateTime
  viewsCount       Int      @default(0)
  isDeleted        Boolean  @default(false)
  createdByAdminId String?
  createdAt        DateTime @default(now())

  brand Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  views BrandStoryView[]

  @@index([brandId, expiresAt])
}

model BrandStoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())

  story BrandStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

// ─── Email Templates ──────────────────────────────────────────────────────────

model EmailTemplate {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  subject          String
  htmlBody         String
  variables        Json?
  isActive         Boolean  @default(true)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── CMS Content Blocks ───────────────────────────────────────────────────────

enum ContentBlockType {
  PAGE
  BANNER
  FAQ
  LEGAL
  BLOCK
}

enum ContentBlockStatus {
  DRAFT
  PUBLISHED
}

model ContentBlock {
  id               String             @id @default(cuid())
  key              String             @unique
  type             ContentBlockType
  title            String?
  body             Json
  status           ContentBlockStatus @default(DRAFT)
  publishedAt      DateTime?
  isDeleted        Boolean            @default(false)
  createdByAdminId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([type, status])
}

// ─── End-user password reset (new — see auth.service.ts#forgotPassword) ──────
// Scalar `userId`, same rationale as UserSuspension below: no Prisma relation
// back onto `model User`, so that model block stays untouched.

model UserPasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Admin-side user suspension record (does NOT gate login — see notes in
// the admin-users module; enforcing this at login would require editing
// auth.service.ts, which is out of scope) ─────────────────────────────────────

model UserSuspension {
  id                 String    @id @default(cuid())
  userId             String
  reason             String?
  suspendedByAdminId String?
  suspendedAt        DateTime  @default(now())
  liftedAt           DateTime?

  @@index([userId, liftedAt])
}

// ─── GenAI SDK request logging (cost/debug tracking) ──────────────────────────

// ─── Persistent Digital Twin ───────────────────────────────────────────────────

model TwinProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  gender        String?
  age           Int?
  heightCm      Int?
  weightKg      Int?
  skinTone      String?
  hairColor     String?
  selfieUrl     String? // The uploaded selfie
  avatarUrl     String? // Generated clean portrait
  baseAvatarUrl String? // Generated full-body twin Drape dresses
  backgroundId  String? // Preferred StudioBackground (scene) id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiRequestLog {
  id               String   @id @default(cuid())
  provider         String
  model            String
  taskType         String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  success          Boolean
  errorMessage     String?
  requestedBy      String? // User.id of the end user, when known
  costUsd          Float? // Estimated spend for this call
  outputUrl        String? // Generated image/video, for image/video models
  metadata         Json? // Engine, garment kind, brand widget id, …
  createdAt        DateTime @default(now())

  evals TryOnEval[]

  @@index([provider, model])
  @@index([createdAt])
  @@index([requestedBy, createdAt])
  @@index([taskType, createdAt])
}

/// Human rubric score for one try-on render (ethnic-wear quality harness).
model TryOnEval {
  id              String   @id @default(cuid())
  aiRequestLogId  String?
  imageUrl        String
  engine          String // "idm-vton" | "kontext-multi" | …
  garmentKind     String // "saree", "lehenga", "kurta", "western", …
  drapeScore      Int // 1-5: fall, pleats, volume
  fidelityScore   Int // 1-5: garment colour/print/embroidery kept
  identityScore   Int // 1-5: face/body/skin tone preserved
  overallScore    Int // 1-5
  notes           String?
  reviewerAdminId String?
  createdAt       DateTime @default(now())

  aiRequestLog AiRequestLog? @relation(fields: [aiRequestLogId], references: [id], onDelete: SetNull)

  @@index([engine, garmentKind])
  @@index([createdAt])
}

// ─── Contact & Support Inquiries ──────────────────────────────────────────────

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  status    ContactStatus @default(PENDING)
  notes     String?
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ─── Studio Scene Backgrounds (Admin Curated & User Panel) ───────────────────

model StudioBackground {
  id               String   @id @default(cuid())
  name             String
  category         String   @default("Studio")
  imageUrl         String?
  cssGradient      String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, order])
}

// ─── In-app notifications (persisted, also pushed over the socket) ───────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // BORROW_REQUEST, CIRCLE_INVITE, EVENT_INVITE, STYLIST_COMMENT, …
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Twin Circle ─────────────────────────────────────────────────────────────

enum CircleMemberKind {
  PROFILE // Managed by the owner: body details + twin, no account of their own
  USER // A friend's own account (and their own twin)
}

enum CircleMemberStatus {
  INVITED
  ACTIVE
  DECLINED
}

model TwinCircle {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TwinCircleMember[]
  events  Event[]
}

model TwinCircleMember {
  id        String             @id @default(cuid())
  circleId  String
  kind      CircleMemberKind   @default(PROFILE)
  status    CircleMemberStatus @default(ACTIVE)
  userId    String? // Set for USER members
  name      String
  relation  String?
  gender    String?
  age       Int?
  heightCm  Int?
  weightKg  Int?
  skinTone  String?
  photo     String?
  twin      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  circle TwinCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId, status])
}

enum BorrowStatus {
  PENDING
  ACCEPTED
  DECLINED
  RETURNED
  CANCELLED
}

model BorrowRequest {
  id             String       @id @default(cuid())
  circleId       String
  ownerId        String // Owner of the item
  requesterId    String
  wardrobeItemId String
  eventId        String?
  kind           String       @default("BORROW") // BORROW | SWAP
  swapItemId     String? // Requester's own item offered in a swap
  status         BorrowStatus @default(PENDING)
  message        String?
  neededBy       DateTime?
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?
  returnedAt     DateTime?

  wardrobeItem WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([requesterId, status])
}

// ─── Event planning + Get Ready With Me ──────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  circleId    String
  createdById String
  title       String
  eventType   String?
  dressCode   String?
  location    String?
  eventDate   DateTime?
  budget      Int?
  notes       String?
  groupId     String? // GroupConversation used as the GRWM chat
  grwmLiveAt  DateTime? // Set while a Get Ready With Me session is running
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  circle TwinCircle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  plans  EventOutfitPlan[]

  @@index([circleId, eventDate])
}

enum PlanStatus {
  PLANNING
  LOCKED
}

model EventOutfitPlan {
  id          String     @id @default(cuid())
  eventId     String
  userId      String? // Account holder this plan is for
  memberId    String? // Or a PROFILE circle member
  lookId      String?
  color       String? // Main colour, used for clash warnings
  note        String?
  status      PlanStatus @default(PLANNING)
  updatedById String?
  updatedAt   DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  look  Look? @relation(fields: [lookId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@unique([eventId, memberId])
}

// ─── Stylist-in-the-loop ──────────────────────────────────────────────────────

enum StylistVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model StylistProfile {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  displayName     String
  bio             String?
  city            String?
  specialties     Json? // ["Bridal", "Sherwani", "Tailoring"]
  portfolioUrl    String?
  status          StylistVerificationStatus @default(PENDING)
  verifiedById    String? // AdminUser.id
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status])
}

model LookStylistComment {
  id        String   @id @default(cuid())
  lookId    String
  stylistId String // StylistProfile.userId
  comment   String
  createdAt DateTime @default(now())

  look Look @relation(fields: [lookId], references: [id], onDelete: Cascade)

  @@index([lookId])
  @@index([stylistId])
}

// ─── Stock-aware brand products ───────────────────────────────────────────────

model BrandProductVariant {
  id          String   @id @default(cuid())
  brandPostId String
  productName String
  size        String
  color       String
  colorHex    String?
  price       Int? // Whole rupees
  inStock     Boolean  @default(true)
  stockCount  Int?
  productUrl  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandPost BrandPost @relation(fields: [brandPostId], references: [id], onDelete: Cascade)

  @@index([brandPostId])
}

model BrandWidgetSession {
  id         String   @id @default(cuid())
  brandId    String
  origin     String?
  productUrl String?
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

// ─── What shoppers do with a brand (feeds the brand dashboard and insights) ──

enum BrandEventType {
  STORE_VIEW
  PRODUCT_VIEW
  DRAPE
  SAVE
  SHARE
  CLICK
}

model BrandEvent {
  id        String         @id @default(cuid())
  brandId   String
  /// The piece it was about, when there is one. Plain id (no FK) so history survives deleting a piece.
  productId String?
  type      BrandEventType
  userId    String?
  /// What the shopper searched for before landing on the store (store views from search only).
  query     String?
  /// Creator collab code the shopper arrived through (click-outs only).
  ref       String?
  createdAt DateTime       @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type, createdAt])
  @@index([productId, type, createdAt])
  @@index([createdAt])
  @@index([ref])
}

// ─── Branded share cards ──────────────────────────────────────────────────────

model ShareEvent {
  id           String    @id @default(cuid())
  lookId       String
  sharedBy     String // User.id
  channel      String // "whatsapp" | "instagram" | "link"
  token        String    @unique
  openCount    Int       @default(0)
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())

  look Look @relation(fields: [lookId], references: [id], onDelete: Cascade)

  @@index([sharedBy])
  @@index([createdAt])
}

// ─── Drape studio generation results ──────────────────────────────────────────

model DrapedResult {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  slots        Json // string[] — GarmentSlot values applied, e.g. ["top","shoes"]
  provider     String // "replicate" | "gemini"
  model        String // model identifier, e.g. "cuuupid/idm-vton" or "gemini-2.0-flash-exp"
  noBackground Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Credits & payments ───────────────────────────────────────────────────────

/// Single row (id "default"), edited from the admin panel.
model BillingSettings {
  id          String   @id @default("default")
  /// Credits every account gets once, for free.
  freeCredits Int      @default(3)
  /// Credits one motion video costs (an image always costs 1).
  videoCost   Int      @default(5)
  currency    String   @default("INR")
  updatedAt   DateTime @updatedAt
}

/// A one-time credit pack, e.g. ₹49 for 15 images.
model CreditPack {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Price in paise (₹49 = 4900).
  pricePaise  Int
  credits     Int
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

/// One checkout: a Razorpay order, and its payment once captured.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  packId            String?
  credits           Int
  /// Amount in paise.
  amount            Int
  currency          String        @default("INR")
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  pack CreditPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Every change to a user's credit balance.
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  /// Positive for grants and refunds, negative for spending.
  delta        Int
  balanceAfter Int
  /// FREE | PURCHASE | DRAPE | LOOK_EDIT | TWIN | VIDEO | REFUND | ADMIN
  reason       String
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Email verification links sent after signup ──────────────────────────────

model UserEmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─── Brand panel: catalog, drops, runway bidding ─────────────────────────────

/// A garment a brand lists. Shoppers see published ones on the brand page.
model BrandProduct {
  id            String   @id @default(cuid())
  brandId       String
  title         String
  sku           String
  price         Float
  originalPrice Float?
  images        String[]
  category      String
  occasions     String[]
  colors        String[]
  sizes         String[]
  stock         Int      @default(0)
  isDrapeReady  Boolean  @default(false)
  drapeScore    Int      @default(0)
  fitScore      Int?
  drapesCount   Int      @default(0)
  clicksCount   Int      @default(0)
  sharesCount   Int      @default(0)
  buyUrl        String
  featured      Boolean  @default(false)
  newDrop       Boolean  @default(false)
  /// The brand's own grouping ("Wedding Edit 2026"). Free text; null = not in a collection.
  collection    String?
  /// What a post used to hold: the caption, and whether it is live for shoppers.
  description   String?
  status        ContentStatus @default(PUBLISHED)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  /// The old BrandPost this piece was created from (set by the migration so it can be re-run safely).
  sourcePostId  String?  @unique
  /// Fit guidance shown beside the size chart, e.g. "Runs small: size up for a relaxed fit".
  fitNotes      String?
  /// { unit: "in" | "cm", columns: string[], rows: string[][] }; the first column is the size.
  sizeChart     Json?
  /// What the piece is made of and how it is patterned (from auto-tagging or typed by the brand).
  fabric        String?
  pattern       String?
  /// Free-form style tags such as "zari" or "anarkali". Searchable.
  tags          String[] @default([])
  /// Keywords the AI writer suggested for the brand's own listings.
  seoKeywords   String[] @default([])
  /// Why the drape-ready photo check failed. Empty when it passed or has not run (see drapeCheckedAt).
  drapeIssues   String[] @default([])
  drapeCheckedAt DateTime?
  /// Set by a store sync (SHOPIFY or WOOCOMMERCE) so the next sync updates this piece instead of adding a copy.
  externalSource String?
  externalId     String?
  syncedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  likes    BrandProductLike[]
  comments BrandProductComment[]
  variants BrandVariant[]
  reviews  BrandProductReview[]

  @@unique([brandId, sku])
  @@index([brandId, createdAt])
  @@index([brandId, status])
  @@index([brandId, collection])
  @@index([brandId, category])
  // Shopper-facing lists: a brand store (newest / price / featured) and the Discover feed.
  @@index([brandId, status, createdAt])
  @@index([brandId, status, price])
  @@index([brandId, status, featured])
  // The Discover feed walks live pieces newest-first by cursor: (publishedAt, id) is exactly that order.
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([brandId, status, publishedAt(sort: Desc)])
  @@index([category, status, publishedAt])
  @@index([brandId, externalSource, externalId])
}

/// One size/colour of a piece with its own stock (and optionally its own price and SKU). When a piece
/// has variants, its own stock, sizes and colours are kept as the roll-up of these rows, so filters,
/// low-stock counts and shopper badges keep working off the piece.
model BrandVariant {
  id         String   @id @default(cuid())
  productId  String
  size       String   @default("")
  color      String   @default("")
  colorHex   String?
  sku        String?
  /// Rupees. Null means the piece's own price.
  price      Float?
  stock      Int      @default(0)
  sortOrder  Int      @default(0)
  /// The store sync's id for this variant.
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId, sortOrder])
}

model BrandDrop {
  id             String   @id @default(cuid())
  brandId        String
  title          String
  collectionName String
  description    String?
  launchDate     DateTime
  bannerUrl      String   @default("")
  productsCount  Int      @default(1)
  /// A short teaser video for the countdown page (an uploaded or AI Studio video).
  teaserUrl      String?
  /** Set once followers and the waitlist have been told the drop is live. */
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand    Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  waitlist DropWaitlistEntry[]

  @@index([brandId, launchDate])
}

/// A brand buying AI credits: one Razorpay order, credited once when it is paid.
model BrandPayment {
  id                String        @id @default(cuid())
  brandId           String
  packId            String
  credits           Int
  /// Amount charged in paise (after any coupon).
  amount            Int
  currency          String        @default("INR")
  couponCode        String?
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([status, createdAt])
}

/// A promo code for brands buying credits: a percentage off and/or bonus credits.
model BrandCoupon {
  id           String    @id @default(cuid())
  code         String    @unique
  percentOff   Int       @default(0)
  bonusCredits Int       @default(0)
  maxUses      Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

/// Copy a brand kept from the AI writer, so it can find it again.
model BrandContentItem {
  id          String   @id @default(cuid())
  brandId     String
  contentType String
  title       String
  body        String
  garmentId   String?
  createdAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt(sort: Desc)])
  @@index([brandId, contentType])
}

/// An AI motion video a brand rendered from a garment photo. Rendering takes minutes, so this is a
/// job: RENDERING while the engine works, then READY (videoUrl is our stored copy) or FAILED
/// (credits given back once, tracked by `refunded`).
model BrandVideo {
  id             String   @id @default(cuid())
  brandId        String
  garmentId      String?
  status         String   @default("RENDERING") // RENDERING | READY | FAILED
  engine         String // "veo" | "replicate"
  model          String
  operation      String? // the engine's job id, used to check progress
  presetId       String
  aspectRatio    String
  durationSec    Int
  prompt         String
  sourceImageUrl String
  videoUrl       String?
  error          String?
  credits        Int
  refunded       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  finishedAt     DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt(sort: Desc)])
  @@index([status])
}

/// One finished model shoot: a flat garment photo rendered as the piece worn by one of the
/// studio's model presets. An image render answers in a single call, so there is no in-progress
/// state here — a row exists only once the frame has been produced and stored.
model BrandModelShot {
  id             String   @id @default(cuid())
  brandId        String
  garmentId      String?
  modelId        String // the body preset: slim | regular | curve | tall | petite | broad
  poseId         String
  backdropId     String
  framingId      String
  direction      String? // the brand's own art-direction line, when it gave one
  prompt         String // exactly what the engine was asked, kept for support and review
  sourceImageUrl String
  imageUrl       String
  provider       String // "gemini" | "replicate"
  model          String
  credits        Int
  createdAt      DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt(sort: Desc)])
  @@index([brandId, garmentId])
}

/// A promo reel: several garments rendered as clips, then stitched with the brand's own
/// opening and closing cards into one 30-45s vertical video ready to post.
model BrandReel {
  id          String    @id @default(cuid())
  brandId     String
  /// RENDERING (shots) | COMPOSING (stitching) | READY | FAILED
  status      String    @default("RENDERING")
  title       String
  styleId     String
  aspectRatio String    @default("9:16")
  engine      String
  model       String
  /// Set once every shot is in and the reel has been stitched.
  videoUrl    String?
  durationSec Int       @default(0)
  error       String?
  credits     Int
  refunded    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  brand Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  shots BrandReelShot[]

  @@index([brandId, createdAt(sort: Desc)])
  @@index([status])
}

/// One outfit inside a reel: its own clip, rendered like a single motion video.
model BrandReelShot {
  id             String   @id @default(cuid())
  reelId         String
  /// Order in the finished reel, from 0.
  position       Int
  garmentId      String?
  /// The lower-third: what the shot says on screen.
  label          String
  caption        String   @default("")
  presetId       String
  /// The engine's job id for this shot.
  operation      String?
  /// RENDERING | READY | FAILED
  status         String   @default("RENDERING")
  sourceImageUrl String
  clipUrl        String?
  error          String?
  prompt         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reel BrandReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, position])
  @@index([reelId])
}

/// A shopper following a brand: they hear about its new drops.
model BrandFollow {
  id        String   @id @default(cuid())
  brandId   String
  userId    String
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId, createdAt])
}

/// A shopper who asked to be told when a drop goes live.
model DropWaitlistEntry {
  id        String   @id @default(cuid())
  dropId    String
  userId    String
  createdAt DateTime @default(now())

  drop BrandDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dropId, userId])
  @@index([userId])
}

enum BidCycleStatus {
  OPEN
  CLOSED
}

/// One auction round (e.g. a month). Admins open it with its slots; it closes at endsAt.
model BidCycle {
  id               String         @id @default(cuid())
  label            String
  startsAt         DateTime       @default(now())
  endsAt           DateTime
  status           BidCycleStatus @default(OPEN)
  closedAt         DateTime?
  createdByAdminId String?
  createdAt        DateTime       @default(now())

  slots BidSlot[]

  @@index([status, endsAt])
}

model BidSlot {
  id                  String  @id @default(cuid())
  cycleId             String
  rank                Int
  title               String
  category            String
  impressionsEstimate String  @default("")
  projectedViews      Int     @default(0)
  projectedDrapes     Int     @default(0)
  minBid              Int     @default(1000)
  /// Filled when the cycle closes.
  winnerBrandId       String?
  winningAmount       Int?
  paid                Boolean @default(false)

  cycle BidCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  bids  Bid[]

  @@unique([cycleId, rank])
}

/// A brand's offer for a slot. The highest bid when the cycle closes wins; payment is settled by staff.
model Bid {
  id        String   @id @default(cuid())
  slotId    String
  brandId   String
  amount    Int
  createdAt DateTime @default(now())

  slot  BidSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  brand Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([slotId, amount])
  @@index([brandId])
}

/// A shopper liking a piece (replaces BrandPostLike).
model BrandProductLike {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

/// A shopper's comment on a piece (replaces BrandPostComment).
model BrandProductComment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  content   String
  /// The brand's answer, shown under the shopper's question.
  brandReply     String?
  brandRepliedAt DateTime?
  createdAt DateTime @default(now())

  product BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

enum TaxonomyKind {
  CATEGORY
  OCCASION
}

/// The lists admins manage: the categories shown as Discover pills and the occasions a piece can be tagged for.
/// Brands pick from these when adding a piece, so the app and the brand panel always agree.
model DiscoverCategory {
  id        String       @id @default(cuid())
  kind      TaxonomyKind @default(CATEGORY)
  name      String
  slug      String
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([kind, slug])
  @@index([kind, isActive, sortOrder])
}

/// A brand's final monthly standing, written once the month is over (live standings for the current
/// month are worked out on demand). Paid placement never feeds into the score.
model BrandRanking {
  id         String   @id @default(cuid())
  /// "2026-11": the month in India time.
  month      String
  brandId    String
  score      Float
  rank       Int
  /// The points by action and the catalog-size adjustment, so the brand can see where the score came from.
  breakdown  Json
  computedAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([month, brandId])
  @@index([month, rank])
  @@index([brandId, month])
}

/// A platform campaign ("Diwali Edit", "Wedding Season Edit") that brands opt into with their own pieces.
model Campaign {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  description      String?
  /// The occasion it is built around, from the admin occasion list (optional).
  occasion         String?
  bannerUrl        String    @default("")
  startsAt         DateTime
  endsAt           DateTime
  /// Brands can join until this moment; empty = until the campaign ends.
  joinBy           DateTime?
  isActive         Boolean   @default(true)
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entries CampaignEntry[]

  @@index([isActive, startsAt, endsAt])
}

/// A brand taking part in a campaign with the pieces it picked.
model CampaignEntry {
  id         String   @id @default(cuid())
  campaignId String
  brandId    String
  productIds String[]
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([campaignId, brandId])
  @@index([brandId])
}

/// Something the Occasion Planner said a shopper's wardrobe is missing for an occasion. Anonymous by
/// design (no user id), so brands can see aggregate wardrobe gaps without any shopper being identifiable.
model PlannerGap {
  id        String   @id @default(cuid())
  occasion  String
  item      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([occasion, createdAt])
}

// ─── Brand community ─────────────────────────────────────────────────────────

/// A brand's post to its followers: a short update, or a poll ("Which colour next?").
model BrandUpdate {
  id          String    @id @default(cuid())
  brandId     String
  /// UPDATE or POLL.
  kind        String    @default("UPDATE")
  body        String
  media       String[]  @default([])
  productIds  String[]  @default([])
  pollOptions String[]  @default([])
  pollEndsAt  DateTime?
  isDeleted   Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  brand Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  votes BrandPollVote[]

  @@index([brandId, publishedAt(sort: Desc)])
  @@index([publishedAt])
}

/// One shopper's vote on a poll (one per poll; voting again changes it).
model BrandPollVote {
  id        String   @id @default(cuid())
  updateId  String
  userId    String
  option    Int
  createdAt DateTime @default(now())

  update BrandUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
}

/// A conversation between a shopper and a brand's inbox (size, fabric, delivery questions).
model BrandThread {
  id            String   @id @default(cuid())
  brandId       String
  userId        String
  productId     String?
  /// OPEN or CLOSED.
  status        String   @default("OPEN")
  brandUnread   Int      @default(0)
  userUnread    Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  brand    Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BrandThreadMessage[]

  @@index([brandId, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
}

model BrandThreadMessage {
  id             String   @id @default(cuid())
  threadId       String
  fromBrand      Boolean
  body           String
  /// Which teammate answered, for the brand's own records.
  brandAccountId String?
  createdAt      DateTime @default(now())

  thread BrandThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// A quick reply a brand reuses in its inbox ("Ships in 3–5 days").
model BrandSavedReply {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  body      String
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// A shopper's rating and review of a piece they tried on. One per shopper per piece; the brand can reply.
model BrandProductReview {
  id             String    @id @default(cuid())
  productId      String
  brandId        String
  userId         String
  rating         Int
  body           String?
  brandReply     String?
  brandRepliedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([brandId, createdAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
}

/// A look a shopper chose to share with a brand. The brand sees only what was submitted, and shows it
/// on its store only once it approves it.
model BrandUgc {
  id         String    @id @default(cuid())
  brandId    String
  userId     String
  lookId     String?
  imageUrl   String
  caption    String?
  /// Show the shopper's username with the look (their choice when submitting).
  showName   Boolean   @default(true)
  /// PENDING, APPROVED or DECLINED.
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, lookId])
  @@index([brandId, status, createdAt(sort: Desc)])
}

/// A shopper-facing offer: a discount code to use on the brand's own site, or a flash sale with a timer.
/// ThreadFlank never takes the payment; it shows the badge and the code, and counts how often it is copied.
model BrandOffer {
  id         String   @id @default(cuid())
  brandId    String
  /// COUPON or FLASH_SALE.
  kind       String
  title      String
  /// The code shoppers copy (coupons only).
  code       String?
  percentOff Int?
  /// Rupees off.
  amountOff  Int?
  /// Pieces it applies to; empty = the whole store.
  productIds String[] @default([])
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean  @default(true)
  copies     Int      @default(0)
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, isActive, endsAt])
}

// ─── Creator collabs (Brand Panel 3.9) ────────────────────────────────────────

/// A brand asks a verified stylist for a look, unboxing or launch post. The code is the tracking link /c/:code.
model CreatorCollab {
  id             String    @id @default(cuid())
  brandId        String
  /// User.id of a VERIFIED StylistProfile.
  creatorId      String
  /// DRAPE_LOOK | UNBOXING | LAUNCH_PROMO
  kind           String
  brief          String
  productIds     String[]  @default([])
  dropId         String?
  /// Rupees, agreed and paid off-platform. Shown to the creator, never to shoppers.
  fee            Int?
  /// PENDING | ACCEPTED | DECLINED | DONE | CANCELLED
  status         String    @default("PENDING")
  code           String    @unique
  deliverableUrl String?
  lookIds        String[]  @default([])
  creatorNote    String?
  respondedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  visits  CreatorVisit[]

  @@index([brandId, status])
  @@index([creatorId, status])
}

/// Someone opened a collab's tracking link. userId only when signed in.
model CreatorVisit {
  id        String   @id @default(cuid())
  collabId  String
  userId    String?
  createdAt DateTime @default(now())

  collab CreatorCollab @relation(fields: [collabId], references: [id], onDelete: Cascade)

  @@index([collabId, createdAt])
}

/// Folders and tags a brand puts on its AI Studio work (saved copy, model shots, videos, reels), so the
/// Content Library can organise items that live in their own tables. One row per tagged item.
model BrandLibraryMeta {
  id        String   @id @default(cuid())
  brandId   String
  /// "copy" | "photo" | "video" | "reel"
  kind      String
  itemId    String
  folder    String?
  tags      String[] @default([])
  updatedAt DateTime @updatedAt

  @@unique([kind, itemId])
  @@index([brandId, folder])
}
